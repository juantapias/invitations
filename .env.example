# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública ("publishable", sb_publishable_...). También funciona la antigua "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta ("secret", sb_secret_...). También funciona la antigua "service_role".
# ⚠️ Solo en el servidor: nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública del sitio (para los enlaces y el calendario)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Botón "Solicitar mi invitación" de la portada (opcional: por defecto +57 333 238 4866)
NEXT_PUBLIC_CONTACT_WHATSAPP=
